{
  // Base image matches the .NET SDK version pinned in global.json (8.0.406).
  // A .NET 10 SDK is installed side-by-side via postCreateCommand to support
  // multitargeting net8.0;net10.0 (see PR #25 / issue #16), mirroring the CI
  // SDK matrix in .github/workflows/ci.yml (dotnet-version: 8.0.x, 10.0.x).
  // Once main fully adopts .NET 10, this can be simplified back to a single SDK.
  "name": "NET Changesets (.NET 8 + .NET 10 SDKs)",
  "image": "mcr.microsoft.com/dotnet/sdk:8.0",
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "true",
    "DOTNET_NOLOGO": "true"
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y dotnet-sdk-10.0 && dotnet restore ./SolarWinds.Changesets.sln",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit"
      ]
    }
  },
  "features": {
    "ghcr.io/solarwinds/devcontainers/features/cato:latest": {}
  }
}
